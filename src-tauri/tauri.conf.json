{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri2-json-schema/refs/heads/main/schemas/2.x.x/tauri-config.schema.json",
  "productName": "ByeType",
  "version": "1.25.0",
  "identifier": "com.byetype.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "ByeType Settings",
        "width": 900,
        "height": 680,
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "visible": false
      },
      {
        "label": "learning",
        "title": "自动学习",
        "url": "learning.html",
        "width": 1180,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      },
      {
        "label": "meeting",
        "title": "会议记录",
        "url": "meeting.html",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "prompts/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "exceptionDomain": "",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "publisher": "ByeType",
    "category": "Utility",
    "shortDescription": "Markdown-driven voice input powered by AI"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBM0RGRDhEMENDMTgzRgpSV1EvR016UTJOK2pEMzQ4L1lrTVR4cThmVWVPanFYOEFGdnRYbm5peVB3cGFNaHZNTVNTRTdRcwo=",
      "endpoints": [
        "https://github.com/cwd0204/byetype/releases/latest/download/latest.json"
      ]
    }
  }
}